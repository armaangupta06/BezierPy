{
  "functions": {
    "api/python/index.py": {
      "runtime": "python3.9",
      "memory": 1024,
      "maxDuration": 10
    }
  },
  "routes": [
    {
      "src": "/api/paths/(.*)",
      "dest": "/api/python/index.py"
    },
    {
      "src": "/api/trajectories/(.*)",
      "dest": "/api/python/index.py"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/python/index.py"
    }
  ]
}
