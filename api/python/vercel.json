{
  "functions": {
    "api/python/index.py": {
      "memory": 1024,
      "maxDuration": 10
    }
  },
  "routes": [
    {
      "src": "/paths/(.*)",
      "dest": "/api/python/index.py"
    },
    {
      "src": "/trajectories/(.*)",
      "dest": "/api/python/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "/api/python/index.py"
    }
  ]
}
